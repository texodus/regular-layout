{
	"compilerOptions": {
		"target": "ESNext",
		"lib": ["ESNext", "DOM"],
		"module": "ESNext",
		"moduleResolution": "bundler",
		"allowImportingTsExtensions": true,
		"strict": true,
		"skipLibCheck": true,
        "declaration": true,
        "outDir": "./dist",
		"emitDeclarationOnly": true
	},
    "include": ["src/**/*"],
	"exclude": ["node_modules", "dist"]
}
